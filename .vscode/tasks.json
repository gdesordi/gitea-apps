{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install Gitea Extension Dependencies",
      "type": "shell",
      "command": "npm ci --prefix apps/extension",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Compile Gitea Extension",
      "type": "shell",
      "command": "npm run compile --prefix apps/extension",
      "problemMatcher": "$tsc",
      "group": "build",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
