{
  "name": "gitea-vscode-extension",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.0.1",
  "publisher": "gdesordi",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:gitea.connectServer"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gitea.connectServer",
        "title": "%command.connectServer.title%",
        "category": "Gitea"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.8.0",
    "@vscode/vsce": "^3.2.0"
  },
  "icon": "./git-icon.png"
}
