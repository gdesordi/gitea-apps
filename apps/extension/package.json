{
  "name": "gitea-vscode-extension",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.0.1",
  "publisher": "gdesordi",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onCommand:gitea.connectServer"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitea.connectServer",
        "title": "%command.connectServer.title%",
        "category": "Gitea"
      }
    ],
    "localization": "./l10n"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.8.0"
  }
}
